@echo off
setlocal EnableExtensions
cd /d "%~dp0"
title DoctorPc - dijagnostika i popravka PC (v4.2)

set "KIRO_DIR=%LOCALAPPDATA%\DoctorPc"
if not exist "%KIRO_DIR%" md "%KIRO_DIR%" >nul 2>&1

echo.
echo   DoctorPc - priprema programa, sacekajte par sekundi...
echo.

set "KIRO_SELF=%~f0"
set "KIRO_OUT=%KIRO_DIR%"

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$o=$env:KIRO_OUT;$L=[System.IO.File]::ReadAllLines($env:KIRO_SELF);$a=$L.IndexOf('::KIRO_ENGINE');$b=$L.IndexOf('::KIRO_GUI');$c=$L.IndexOf('::KIRO_PLUGINS');if($a -lt 0 -or $b -lt 0 -or $c -lt 0){Write-Host 'GRESKA: paket nije nadjen u fajlu.' -ForegroundColor Red;exit 91};function GetPay($x,$y){($L[($x+1)..($y-1)] | Where-Object { $_ -match '^::[A-Za-z0-9+/=]+$' } | ForEach-Object { $_.Substring(2) }) -join ''};try{[System.IO.File]::WriteAllBytes((Join-Path $o 'KiRo_PC_Diagnostic_Repair_v4_2_ENGINE.ps1'),[Convert]::FromBase64String((GetPay $a $b)));[System.IO.File]::WriteAllBytes((Join-Path $o 'KiRo_PC_Diagnostic_Repair_v4_2_GUI.ps1'),[Convert]::FromBase64String((GetPay $b $c)));[System.IO.File]::WriteAllBytes((Join-Path $o 'Plugins.zip'),[Convert]::FromBase64String((GetPay $c $L.Length)))}catch{Write-Host ('GRESKA pri raspakivanju: '+$_.Exception.Message) -ForegroundColor Red;exit 92};$pz=Join-Path $o 'Plugins.zip';if(Test-Path -LiteralPath $pz){try{Expand-Archive -LiteralPath $pz -DestinationPath $o -Force -ErrorAction Stop}catch{};Remove-Item -LiteralPath $pz -Force -ErrorAction SilentlyContinue};exit 0"
if errorlevel 1 goto :EXTERR

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$t=$null;$e=$null;[System.Management.Automation.Language.Parser]::ParseFile((Join-Path $env:KIRO_OUT 'KiRo_PC_Diagnostic_Repair_v4_2_GUI.ps1'),[ref]$t,[ref]$e)|Out-Null;if($e.Count){$e|ForEach-Object{Write-Host ('Linija '+$_.Extent.StartLineNumber+': '+$_.Message)};exit 90}else{exit 0}"
if errorlevel 1 goto :BADCODE

if "%KIRO_EXTRACT_ONLY%"=="1" (
  echo Extract-only OK: %KIRO_DIR%
  exit /b 0
)

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "%KIRO_DIR%\KiRo_PC_Diagnostic_Repair_v4_2_GUI.ps1"
set "RC=%ERRORLEVEL%"

if not "%RC%"=="0" (
  echo.
  echo DoctorPc se zaustavio sa greskom. Kod: %RC%
  echo Logovi su u Documents\KiRo_PC_Diagnostic_Logs
  pause
)
exit /b %RC%

:EXTERR
echo.
echo DoctorPc nije mogao da se raspakuje. Kod: %ERRORLEVEL%
pause
exit /b 91

:BADCODE
echo.
echo DoctorPc nije pokrenut zbog greske u programu (prikazana iznad).
pause
exit /b 90

